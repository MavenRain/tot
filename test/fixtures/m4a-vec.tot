-- M4 Stage A, gate PASS-M4A-VEC.  A recursive indexed family (Vec) and
-- a sibling (Fin) declare, and a hand-built Vec value runs.  Every part
-- of this file uses new M4 syntax (an index telescope after the data
-- header's colon), so this gate is the file's first execution; a
-- regression here means indexed inductive families broke.
data Vec (0 A : Type 0) : Nat -> Type 0 :=
  | vnil : Vec A zero
  | vcons : (0 n : Nat) -> A -> Vec A n -> Vec A (succ n)
data Fin : Nat -> Type 0 :=
  | fzero : (0 n : Nat) -> Fin (succ n)
  | fsucc : (0 n : Nat) -> Fin n -> Fin (succ n)
def twoNats : Vec Nat (succ (succ zero)) :=
  vcons Nat (succ zero) zero (vcons Nat zero (succ zero) (vnil Nat))
eval twoNats
