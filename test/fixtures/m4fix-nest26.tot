-- M4 fixes round 1 (ctxcat id 7): 26 matches nested in SCRUTINEE
-- position.  The staged two-pass match_scrut cost 2^depth here
-- (measured: 1.08s at depth 20, doubling per level, so about 70s at
-- depth 26, past this gate own 30s watchdog).  One inference per
-- match makes it linear.
def nest26 : Bool := match (match (match (match (match (match (match (match (match (match (match (match (match (match (match (match (match (match (match (match (match (match (match (match (match (match (true) as x0 return Bool with | true => false | false => true end) as x1 return Bool with | true => false | false => true end) as x2 return Bool with | true => false | false => true end) as x3 return Bool with | true => false | false => true end) as x4 return Bool with | true => false | false => true end) as x5 return Bool with | true => false | false => true end) as x6 return Bool with | true => false | false => true end) as x7 return Bool with | true => false | false => true end) as x8 return Bool with | true => false | false => true end) as x9 return Bool with | true => false | false => true end) as x10 return Bool with | true => false | false => true end) as x11 return Bool with | true => false | false => true end) as x12 return Bool with | true => false | false => true end) as x13 return Bool with | true => false | false => true end) as x14 return Bool with | true => false | false => true end) as x15 return Bool with | true => false | false => true end) as x16 return Bool with | true => false | false => true end) as x17 return Bool with | true => false | false => true end) as x18 return Bool with | true => false | false => true end) as x19 return Bool with | true => false | false => true end) as x20 return Bool with | true => false | false => true end) as x21 return Bool with | true => false | false => true end) as x22 return Bool with | true => false | false => true end) as x23 return Bool with | true => false | false => true end) as x24 return Bool with | true => false | false => true end) as x25 return Bool with | true => false | false => true end
check nest26
