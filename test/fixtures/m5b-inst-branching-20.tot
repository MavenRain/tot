instance : SC Bool := mkSC Bool true
instance : (0 A : Type 0) -> SC A -> SC A -> SC (SBox A) :=
  fun A d1 d2 => mkSC (SBox A) true
def deepBranching : Bool := sc (SBox (SBox (SBox (SBox (SBox (SBox (SBox (SBox (SBox (SBox (SBox (SBox (SBox (SBox (SBox (SBox (SBox (SBox (SBox (SBox Bool)))))))))))))))))))) auto
