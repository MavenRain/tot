#!/usr/bin/env -S tot run
-- M5 Stage D (plan D4): a NARROW port of the house map-over-rewrap
-- Bash guard (~/.claude/hooks/map-over-rewrap-bash-guard.py).  The
-- Python guard denies a NET-NEW `let x = <expr>?;` whose block
-- immediately returns `Ok(<uses x>)`, taking four conditions
-- together: the bare `let` binding ending in `?`, `Ok(` as the very
-- next tokens, the `Ok(_)` as a block TAIL, and the bound name
-- genuinely used inside the `Ok(_)`.  It scrubs comments and strings,
-- reconstructs the post-edit file, and compares occurrence counts.
--
-- THIS port implements criteria 1 and 2 ONLY, on raw text:
--   * only tool_name = "Bash";
--   * only a command whose text mentions ".rs";
--   * only the LINE-PAIR shape: a line whose first token is `let` and
--     whose last token ends with `?;`, immediately followed by a
--     non-empty line whose first token starts with `Ok(`.
-- Everything else ALLOWS.
--
-- M6 Stage E (criterion 3): the SCRUBBER is ported, line-based and
-- narrow, applied to the command's lines before the pair test:
--   * `//` cuts the rest of its line, unless the text before it holds
--     an odd count of `"` (then the `//` sits inside a string and the
--     line is kept whole, so a `//` comment AFTER that string on the
--     same line is not cut;  M6 Stage G);
--   * an unmatched `/*` cuts its line and opens comment state;  the
--     line holding the closing `*/` is dropped WHOLE (code after `*/`
--     on that line is lost, fail-open);
--   * a line holding both `/*` and `*/` keeps only the text before
--     `/*`;
--   * an odd count of `"` cuts the line at its first `"` and opens
--     string state;  the line holding the closing `"` is dropped
--     WHOLE;  balanced inline quotes are NOT blanked;
--   * no escapes, char literals or raw strings are understood;
--   * the trailing-whitespace miss of lastToken (below) carries over.
-- The block-tail test, the used-name test and the net-new comparison
-- are NOT ported, so this guard is louder than the Python one on a
-- pre-existing rewrap tail inside a heredoc and quieter than it on a
-- single-line tail (both directions recorded in SPEC section 6).  It
-- fails open on everything it does not recognise, matching the other
-- two guards.
--
-- The tokenizer helpers (firstNonEmpty, lastOr, splitEach,
-- firstToken) are COPIED from examples/guard.tot on purpose: there
-- are no modules and the global namespace is flat, and moving them
-- into stdlib/prelude.tot would change the prelude, the bootstrap and
-- the cache (Stage A/B scope, not Stage D scope).  SPEC section 6
-- records the duplication as a debt.

def rec firstNonEmpty : List String -> String :=
  fun ts =>
    match ts with
    | nil => ""
    | cons h t => match stringEq h "" with | true => firstNonEmpty t | false => h end
    end

def rec lastOr : String -> List String -> String :=
  fun d xs =>
    match xs with
    | nil => d
    | cons h t => match t with | nil => h | cons h2 t2 => lastOr d t end
    end

def rec splitEach : String -> List String -> List String :=
  fun sep xs =>
    match xs with
    | nil => nil _
    | cons h t => append _ (stringSplit h sep) (splitEach sep t)
    end

def firstToken : String -> String :=
  fun cmd =>
    firstNonEmpty (splitEach "\r" (splitEach "\n" (splitEach "\t" (stringSplit cmd " "))))

-- The LAST token under the same four-way IFS tokenization.  A line
-- with trailing whitespace yields a final empty token and lastOr
-- returns it; the narrow port accepts that miss (raw-text criteria
-- only, per the header).
def lastToken : String -> String :=
  fun cmd =>
    lastOr "" (splitEach "\r" (splitEach "\n" (splitEach "\t" (stringSplit cmd " "))))

def startsWith : String -> String -> Bool :=
  fun p s =>
    match stringSlice s 0 (stringLength p) with
    | none => false
    | some pre => stringEq pre p
    end

-- No length pre-check: a suffix longer than the string makes the
-- start negative, and stringSlice returns none for a negative start,
-- so the none arm IS the answer, not an error path.
def endsWith : String -> String -> Bool :=
  fun q s =>
    match stringSlice s (intSub (stringLength s) (stringLength q))
                        (stringLength q) with
    | none => false
    | some suf => stringEq suf q
    end

-- Drop lines that are empty under IFS tokenization, so a blank line
-- between the `let` and the `Ok(` does not hide the pair.
def rec dropEmpty : List String -> List String :=
  fun xs =>
    match xs with
    | nil => nil _
    | cons h t =>
        match stringEq (firstToken h) "" with
        | true => dropEmpty t
        | false => cons _ h (dropEmpty t)
        end
    end

-- Criteria 1 and 2 on an adjacent line pair, sliding one line at a
-- time.  Both recursions shrink the list argument, so rec_arg
-- first-fit picks the list and the termination guard accepts them.
def rec hasRewrapPair : List String -> Bool :=
  fun ls =>
    match ls with
    | nil => false
    | cons l1 rest =>
        match rest with
        | nil => false
        | cons l2 t2 =>
            match andb (stringEq (firstToken l1) "let")
                       (andb (endsWith "?;" (lastToken l1))
                             (startsWith "Ok(" (firstToken l2))) with
            | true => true
            | false => hasRewrapPair rest
            end
        end
    end

-- Echo plumbing, the D3 shape: bound the attacker-controlled command
-- at 2000 bytes and let the Stage A JSON escaper quote it on the way
-- out.  Copied from examples/guard.tot (same flat-namespace reason).
def orEmpty : Option String -> String :=
  fun o => match o with | none => "" | some s => s end

def elideAt : Int -> String -> String :=
  fun n s =>
    match intCompare (stringLength s) n with
    | lt => s
    | eq => s
    | gt => stringConcat (orEmpty (stringSlice s 0 n)) "... (elided)"
    end

-- M6 Stage E: criterion 3, the scrubber.  Line-based, narrow,
-- fail-open; the recorded misses are listed above.
data Scrub : Type 0 :=
  | sCode : Scrub
  | sComment : Scrub
  | sString : Scrub

def quoteTok : String := "\""

-- text before the first occurrence of sep (the whole string when
-- sep is absent: stringSplit then yields the one-piece list)
def beforeFirst : String -> String -> String :=
  fun sep s => headOr _ s (stringSplit s sep)

def rec evenPieces : List String -> Bool :=
  fun xs =>
    match xs with
    | nil => true
    | cons h t => boolEq (evenPieces t) false
    end

-- odd count of '"' in s  <=>  stringSplit s quoteTok has even length
def oddQuotes : String -> Bool :=
  fun s => evenPieces (stringSplit s quoteTok)

-- M6 Stage G: a `//` whose prefix has an odd quote count is inside a
-- string, so it does not cut (a `let url = "https://x";` line used to
-- open a phantom string state and drop the next line whole).
def cutSlash : String -> String :=
  fun l =>
    match oddQuotes (beforeFirst "//" l) with
    | true => l
    | false => beforeFirst "//" l
    end

def cutBlock : String -> String :=
  fun l =>
    match stringContains (cutSlash l) "/*" with
    | true => beforeFirst "/*" (cutSlash l)
    | false => cutSlash l
    end

-- the kept text of a code-state line
def scrubCode : String -> String :=
  fun l =>
    match oddQuotes (cutBlock l) with
    | true => beforeFirst quoteTok (cutBlock l)
    | false => cutBlock l
    end

-- the state AFTER a code-state line.  An unmatched /* wins over a
-- quote: a quote inside an opened comment is comment text.
def nextState : String -> Scrub :=
  fun l =>
    match andb (stringContains (cutSlash l) "/*")
               (boolEq (stringContains (cutSlash l) "*/") false) with
    | true => sComment
    | false =>
        match oddQuotes (cutBlock l) with
        | true => sString
        | false => sCode
        end
    end

def rec scrubLines : Scrub -> List String -> List String :=
  fun st ls =>
    match ls with
    | nil => nil _
    | cons l t =>
        match st with
        | sCode => cons _ (scrubCode l) (scrubLines (nextState l) t)
        | sComment =>
            match stringContains l "*/" with
            | true => scrubLines sCode t
            | false => scrubLines sComment t
            end
        | sString =>
            match stringContains l quoteTok with
            | true => scrubLines sCode t
            | false => scrubLines sString t
            end
        end
    end

def rewrapVerdict : String -> Verdict :=
  fun cmd =>
    match stringContains cmd ".rs" with
    | true =>
        match hasRewrapPair (dropEmpty (scrubLines sCode (stringSplit cmd "\n"))) with
        | true =>
            deny (stringConcat
                    "house rule: map over the value instead of a let-then-Ok rewrap (command: "
                    (stringConcat (elideAt 2000 cmd) ")"))
        | false => allow
        end
    | false => allow
    end

def decideRewrap : Json -> Verdict :=
  fun payload =>
    match jsonGetString payload "tool_name" with
    | none => allow
    | some name =>
        match stringEq name "Bash" with
        | true =>
            match jsonGet payload "tool_input" with
            | none => allow
            | some ti => rewrapVerdict (jsonGetStringOr ti "command" "")
            end
        | false => allow
        end
    end

-- Fail open on a parse failure, the posture the other two guards
-- keep (an installation that wants fail-closed spells the hook
-- command `tot run --strict-json <this file>`).
def main : IO Verdict :=
  let* _ _ raw := readStdin in
  let* _ _ parsed := liftIO _ (jsonParse raw) in
  match parsed with
  | none => pureIO _ allow
  | some payload => pureIO _ (decideRewrap payload)
  end
