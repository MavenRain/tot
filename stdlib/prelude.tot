-- tot prelude (M2): core data types and functions.
data Bool : Type 0 := | true : Bool | false : Bool
data Nat : Type 0 := | zero : Nat | succ : Nat -> Nat
data Option (0 A : Type 0) : Type 0 := | none : Option A | some : A -> Option A
data Result (0 A : Type 0) (0 E : Type 0) : Type 0 := | ok : A -> Result A E | err : E -> Result A E
data List (0 A : Type 0) : Type 0 := | nil : List A | cons : A -> List A -> List A
data Pair (0 A : Type 0) (0 B : Type 0) : Type 0 := | pair : A -> B -> Pair A B
data Unit : Type 0 := | unit : Unit
def not : Bool -> Bool := fun b => match b with | true => false | false => true end
def andb : Bool -> Bool -> Bool := fun a b => match a as x return Bool with | true => b | false => false end
def orb : Bool -> Bool -> Bool := fun a b => match a as x return Bool with | true => true | false => b end
reducible def rec add : Nat -> Nat -> Nat := fun m n => match m with | zero => n | succ p => succ (add p n) end
reducible def rec mul : Nat -> Nat -> Nat := fun m n => match m with | zero => zero | succ p => add n (mul p n) end
def isZero : Nat -> Bool := fun n => match n with | zero => true | succ p => false end
def fromOption : (0 A : Type 0) -> A -> Option A -> A := fun A d o => match o with | none => d | some x => x end
def rec append : (0 A : Type 0) -> List A -> List A -> List A := fun A xs ys => match xs with | nil => ys | cons h t => cons _ h (append _ t ys) end
def rec map : (0 A : Type 0) -> (0 B : Type 0) -> (A -> B) -> List A -> List B := fun A B f xs => match xs with | nil => nil _ | cons h t => cons _ (f h) (map _ _ f t) end
def rec foldNat : (0 A : Type 0) -> A -> (A -> A) -> Nat -> A := fun A z s n => match n with | zero => z | succ p => s (foldNat A z s p) end
-- M3 Stage C: stdlib breadth (full prim catalog, self-recursive Json).
data Ordering : Type 0 := | lt : Ordering | eq : Ordering | gt : Ordering
data Verdict : Type 0 := | allow : Verdict | ask : String -> Verdict | deny : String -> Verdict
data ProcessResult : Type 0 := | mkProcessResult : Int -> String -> String -> ProcessResult
-- Every constructor argument mentions Json only as Json (never as
-- "List Json"), so M2 positivity accepts it unchanged and no nested-
-- inductive kernel work is needed (M3 design verdict decision 2). The
-- price is duplicated array/object combinators plus the jsonToList
-- bridge into the generic List combinators below (List Json is legal
-- as a RETURN type, which is why the bridge works). M4 migrates to
-- "jarr : List Json -> Json" behind the same accessor names.
data Json : Type 0 :=
  | jnull : Json
  | jbool : Bool -> Json
  | jnum : Int -> Json
  | jstr : String -> Json
  | jarrNil : Json
  | jarrCons : Json -> Json -> Json
  | jobjNil : Json
  | jobjCons : String -> Json -> Json -> Json
def headOr : (0 A : Type 0) -> A -> List A -> A := fun A d xs => match xs with | nil => d | cons h t => h end
-- walks the jobjCons spine; rec_arg = 0 (the tail binder t, bound by
-- matching j, is structurally smaller)
def rec jsonGet : Json -> String -> Option Json := fun j k => match j with | jnull => none _ | jbool b => none _ | jnum n => none _ | jstr s => none _ | jarrNil => none _ | jarrCons h t => none _ | jobjNil => none _ | jobjCons k2 v tail => match stringEq k2 k with | true => some _ v | false => jsonGet tail k end end
def jsonAsString : Json -> Option String := fun j => match j with | jnull => none _ | jbool b => none _ | jnum n => none _ | jstr s => some _ s | jarrNil => none _ | jarrCons h t => none _ | jobjNil => none _ | jobjCons k v t => none _ end
def jsonAsInt : Json -> Option Int := fun j => match j with | jnull => none _ | jbool b => none _ | jnum n => some _ n | jstr s => none _ | jarrNil => none _ | jarrCons h t => none _ | jobjNil => none _ | jobjCons k v t => none _ end
def jsonGetString : Json -> String -> Option String := fun j k => match jsonGet j k with | none => none _ | some v => jsonAsString v end
def jsonGetStringOr : Json -> String -> String -> String := fun j k d => match jsonGetString j k with | none => d | some s => s end
-- walks the jarrCons spine; rec_arg = 0 (the tail binder t, bound by
-- matching j, is structurally smaller)
def rec jsonToList : Json -> List Json := fun j => match j with | jnull => nil _ | jbool b => nil _ | jnum n => nil _ | jstr s => nil _ | jarrNil => nil _ | jarrCons h t => cons _ h (jsonToList t) | jobjNil => nil _ | jobjCons k v t => nil _ end
-- M4 Stage B: propositional equality.  Homogeneous Paulin-Mohring:
-- parameters are the type and the LEFT endpoint, the right endpoint is
-- the single index, and refl is the sole constructor.  Type 0 only;  a
-- Type 1 need duplicates the def.  There is no K and no UIP.
data Empty : Type 0 :=
data Eq (0 A : Type 0) (0 a : A) : (0 b : A) -> Type 0 := | refl : Eq A a a
data Dec (0 P : Type 0) : Type 0 :=
  | yes : (0 p : P) -> Dec P
  | no : (0 np : P -> Empty) -> Dec P

def exfalso : (0 A : Type 0) -> (0 e : Empty) -> A :=
  fun A e => match e with end

reducible def subst0 : (0 A : Type 0) -> (0 a : A) -> (0 b : A) ->
    (0 P : A -> Type 0) -> (0 h : Eq A a b) -> P a -> P b :=
  fun A a b P h px => match h as x in Eq y return P y with | refl => px end

reducible def J0 : (0 A : Type 0) -> (0 a : A) ->
    (0 P : (y : A) -> Eq A a y -> Type 0) ->
    P a (refl A a) -> (0 b : A) -> (0 h : Eq A a b) -> P b h :=
  fun A a P pr b h => match h as x in Eq y return P y x with | refl => pr end

reducible def sym0 : (0 A : Type 0) -> (0 a : A) -> (0 b : A) ->
    (0 h : Eq A a b) -> Eq A b a :=
  fun A a b h => subst0 A a b (fun z => Eq _ z a) h (refl A a)

-- TRAP, do NOT "simplify" this to subst0 A b c (fun z => Eq A a z) h2 h1.
-- A def body checks at quantity mode w, and subst0's last argument sits
-- at a w position, so forwarding the 0-bound proof h1 there is
-- Erased_use.  The nested double match eliminates h1 INSIDE h2's refl
-- branch and returns a freshly built refl instead of forwarding a
-- binder.
reducible def trans0 : (0 A : Type 0) -> (0 a : A) -> (0 b : A) -> (0 c : A) ->
    (0 h1 : Eq A a b) -> (0 h2 : Eq A b c) -> Eq A a c :=
  fun A a b c h1 h2 =>
    match h2 as x2 in Eq y2 return Eq A a y2 with
    | refl =>
        match h1 as x1 in Eq y1 return Eq A a y1 with
        | refl => refl A a
        end
    end

reducible def cong0 : (0 A : Type 0) -> (0 B : Type 0) -> (0 a : A) -> (0 b : A) ->
    (0 f : A -> B) -> (0 h : Eq A a b) -> Eq B (f a) (f b) :=
  fun A B a b f h => subst0 A a b (fun z => Eq B (f a) (f z)) h (refl B (f a))

reducible def pred : Nat -> Nat :=
  fun n => match n with | zero => zero | succ p => p end
reducible def natFamZero : Nat -> Type 0 :=
  fun n => match n with | zero => Unit | succ p => Empty end
def zeroNotSucc : (0 n : Nat) -> (0 h : Eq Nat zero (succ n)) -> Empty :=
  fun n h => subst0 Nat zero (succ n) natFamZero h unit
def succInj : (0 m : Nat) -> (0 n : Nat) ->
    (0 h : Eq Nat (succ m) (succ n)) -> Eq Nat m n :=
  fun m n h => cong0 Nat Nat (succ m) (succ n) pred h

def rec natDecEq : (m : Nat) -> (n : Nat) -> Dec (Eq Nat m n) :=
  fun m n =>
    match m as mm return Dec (Eq Nat mm n) with
    | zero =>
        match n as nn return Dec (Eq Nat zero nn) with
        | zero => yes (Eq Nat zero zero) (refl Nat zero)
        | succ p => no (Eq Nat zero (succ p)) (fun h => zeroNotSucc p h)
        end
    | succ q =>
        match n as nn return Dec (Eq Nat (succ q) nn) with
        | zero => no (Eq Nat (succ q) zero)
            (fun h => zeroNotSucc q (sym0 Nat (succ q) zero h))
        | succ r =>
            match natDecEq q r as d return Dec (Eq Nat (succ q) (succ r)) with
            | yes p => yes (Eq Nat (succ q) (succ r)) (cong0 Nat Nat q r succ p)
            | no np => no (Eq Nat (succ q) (succ r)) (fun h => np (succInj q r h))
            end
        end
    end
-- M4 Stage B: the monad laws are invisible to conversion by design
-- (liftIO (pureDiv x) and pureIO x are different neutrals), so they are
-- POSTULATED.  Consistency argument: IO and Div are declared-only,
-- zero-constructor type formers, so no internal predicate can
-- eliminate an IO or Div value and therefore none can distinguish the
-- action trees these axioms equate.  Every use sits under an erased
-- application and is dropped wholesale by erasure.
axiom ioBindPure : (0 A : Type 0) -> (0 B : Type 0) -> (0 a : A) ->
  (0 f : A -> IO B) -> Eq (IO B) (bindIO A B (pureIO A a) f) (f a)
axiom ioBindRet : (0 A : Type 0) -> (0 m : IO A) ->
  Eq (IO A) (bindIO A A m (fun a => pureIO A a)) m
axiom ioBindAssoc : (0 A : Type 0) -> (0 B : Type 0) -> (0 C : Type 0) ->
  (0 m : IO A) -> (0 f : A -> IO B) -> (0 g : B -> IO C) ->
  Eq (IO C) (bindIO B C (bindIO A B m f) g)
            (bindIO A C m (fun a => bindIO B C (f a) g))
-- M4 Stage D: deterministic single-parameter type classes.  A class is
-- a single-constructor dictionary data type plus projection defs;  an
-- instance is an ordinary global under a mangled name, and coherence is
-- Duplicate_global on that name.  Daily call sites write "auto".
def rec anyList : (0 A : Type 0) -> (A -> Bool) -> List A -> Bool :=
  fun A p xs => match xs with | nil => false | cons h t => orb (p h) (anyList _ p t) end
reducible def boolEq : Bool -> Bool -> Bool :=
  fun a b =>
    match a as x return Bool with
    | true => match b as y return Bool with | true => true | false => false end
    | false => match b as y return Bool with | true => false | false => true end
    end
def rec listEqBy : (0 A : Type 0) -> (A -> A -> Bool) -> List A -> List A -> Bool :=
  fun A f xs ys =>
    match xs as xx return Bool with
    | nil => match ys as yy return Bool with | nil => true | cons h2 t2 => false end
    | cons h1 t1 =>
        match ys as yy return Bool with
        | nil => false
        | cons h2 t2 => andb (f h1 h2) (listEqBy _ f t1 t2)
        end
    end

class EqD (0 A : Type 0) := { eqf : A -> A -> Bool }
class OrdD (0 A : Type 0) := { cmpf : A -> A -> Ordering }
class ShowD (0 A : Type 0) := { showf : A -> String }

instance : EqD Int := mkEqD Int intEq
instance : EqD String := mkEqD String stringEq
instance : EqD Bool := mkEqD Bool boolEq
instance : OrdD Int := mkOrdD Int intCompare
instance : ShowD Int := mkShowD Int intToString
instance : (0 A : Type 0) -> EqD A -> EqD (List A) :=
  fun A d => mkEqD (List A) (listEqBy _ (eqf A d))

def member : (0 A : Type 0) -> EqD A -> A -> List A -> Bool :=
  fun A d x xs => anyList _ (eqf A d x) xs

-- M7 Stage D (2026-09-04): the six shared guard helpers.  They moved
-- out of examples/guard.tot and examples/guard-rewrap.tot.  Each name
-- is spelled once here.  The two guards use these prelude globals.
def rec firstNonEmpty : List String -> String :=
  fun ts =>
    match ts with
    | nil => ""
    | cons h t => match stringEq h "" with | true => firstNonEmpty t | false => h end
    end

def rec lastOr : String -> List String -> String :=
  fun d xs =>
    match xs with
    | nil => d
    | cons h t => match t with | nil => h | cons h2 t2 => lastOr d t end
    end

-- Split every fragment again on one more separator, concatenating
-- the piece lists in order (fold of stringSplit over the fragments).
def rec splitEach : String -> List String -> List String :=
  fun sep xs =>
    match xs with
    | nil => nil _
    | cons h t => append _ (stringSplit h sep) (splitEach sep t)
    end

-- Tokenize on the four shell IFS whitespace characters: space, tab,
-- newline, carriage return.
def firstToken : String -> String :=
  fun cmd =>
    firstNonEmpty (splitEach "\r" (splitEach "\n" (splitEach "\t" (stringSplit cmd " "))))

-- Unwrap a bounds-checked slice.  stringSlice is partial by type
-- (Option String) and total by behaviour: it returns none for any
-- out-of-range window (stringSlice "abc" 0 99 = none, and a negative
-- start is none too), so this default is unreachable for the windows
-- elideAt builds and is a backstop, not a fallback.
def orEmpty : Option String -> String :=
  fun o => match o with | none => "" | some s => s end

-- Bound the echoed command at 2000 bytes, the house elision width
-- (M4 fixes round 5).  intCompare returns Ordering, so all three
-- arms are named and no arm is a wildcard.  Arm order is lt, eq, gt:
-- tot pins match arms to declaration order (the plan's gt-first
-- spelling is a parse-time reject; conflict note in
-- dev/M5-BUILD-LOG.md).
def elideAt : Int -> String -> String :=
  fun n s =>
    match intCompare (stringLength s) n with
    | lt => s
    | eq => s
    | gt => stringConcat (orEmpty (stringSlice s 0 n)) "... (elided)"
    end
